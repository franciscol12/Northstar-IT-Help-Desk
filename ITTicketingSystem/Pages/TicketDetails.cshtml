@page
@model ITTicketingSystem.Pages.TicketDetailsModel

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="container mt-4">

    <div class="mb-4">
        <a asp-page="/Tickets" class="btn btn-outline-secondary btn-sm">
            Back to Support Tickets
        </a>
    </div>

    @if (TempData["AssignmentSuccess"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["AssignmentSuccess"]
        </div>
    }

    @if (TempData["AssignmentError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["AssignmentError"]
        </div>
    }

    @if (TempData["NoteSuccess"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["NoteSuccess"]
        </div>
    }

    @if (TempData["NoteError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["NoteError"]
        </div>
    }

    @if (TempData["EscalationSuccess"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["EscalationSuccess"]
        </div>
    }

    @if (TempData["EscalationError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["EscalationError"]
        </div>
    }

    @if (TempData["AcceptanceSuccess"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["AcceptanceSuccess"]
        </div>
    }

    @if (TempData["AcceptanceError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["AcceptanceError"]
        </div>
    }

    @if (TempData["ResolutionSuccess"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["ResolutionSuccess"]
        </div>
    }

    @if (TempData["ResolutionError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ResolutionError"]
        </div>
    }

    @if (TempData["ClosureSuccess"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["ClosureSuccess"]
        </div>
    }

    @if (TempData["ClosureError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ClosureError"]
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.Ticket != null)
    {
        <div class="mb-4">
            <h1>Ticket #@Model.Ticket.TicketID</h1>
            <h4 class="text-muted">@Model.Ticket.Title</h4>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Ticket Information</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <strong>Status:</strong>
                        @Model.Ticket.Status
                    </div>

                    <div class="col-md-6">
                        <strong>Priority:</strong>
                        @Model.Ticket.Priority
                    </div>

                    <div class="col-md-6">
                        <strong>Requested By:</strong>
                        @Model.Ticket.RequestedBy
                    </div>

                    <div class="col-md-6">
                        <strong>Category:</strong>
                        @Model.Ticket.CategoryName
                    </div>

                    <div class="col-md-6">
                        <strong>Assigned Technician:</strong>
                        @Model.Ticket.AssignedTechnician
                    </div>

                    <div class="col-md-6">
                        <strong>Support Tier:</strong>
                        @Model.Ticket.CurrentSupportTier
                    </div>

                    <div class="col-md-6">
                        <strong>Created:</strong>
                        @Model.Ticket.CreatedAt.ToString("MM/dd/yyyy h:mm tt")
                    </div>

                    <div class="col-12">
                        <strong>Description:</strong>
                        <p class="mt-2">@Model.Ticket.Description</p>
                    </div>

                </div>
            </div>
        </div>

        @if (Model.Ticket.Status == "Open" &&
     Model.Ticket.AssignedTechnician == "Unassigned")
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Assign Technician</h5>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        Select an available Tier
                        @Model.Ticket.CurrentSupportTier technician.
                    </p>

                    <form method="post" asp-page-handler="Assign">
                        <input type="hidden"
                               name="id"
                               value="@Model.Ticket.TicketID" />

                        <div class="mb-3">
                            <label asp-for="SelectedTechnicianID"
                                   class="form-label">
                                Technician
                            </label>

                            <select asp-for="SelectedTechnicianID"
                                    asp-items="Model.AvailableTechnicians"
                                    class="form-select">
                                <option value="0">
                                    -- Select Technician --
                                </option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Assign Technician
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.Ticket.Status == "In Progress" &&
     Model.Ticket.AssignedTechnicianID.HasValue)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Add Troubleshooting Note</h5>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        Document the troubleshooting steps performed
                        by @Model.Ticket.AssignedTechnician.
                    </p>

                    <form method="post" asp-page-handler="AddNote">

                        <input type="hidden"
                               name="id"
                               value="@Model.Ticket.TicketID" />

                        <div class="mb-3">
                            <label asp-for="TroubleshootingNote"
                                   class="form-label">
                                Troubleshooting Notes
                            </label>

                            <textarea asp-for="TroubleshootingNote"
                                      class="form-control"
                                      rows="4"
                                      maxlength="4000"
                                      required
                                      placeholder="Describe the troubleshooting steps and findings..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Save Troubleshooting Note
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.Ticket.Status == "In Progress" &&
     Model.Ticket.AssignedTechnicianID.HasValue &&
     Model.Ticket.CurrentSupportTier < 3)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Escalate Ticket</h5>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        Escalate this ticket from Tier
                        @Model.Ticket.CurrentSupportTier
                        to Tier @(Model.Ticket.CurrentSupportTier + 1).
                    </p>

                    <form method="post" asp-page-handler="Escalate">

                        <input type="hidden"
                               name="id"
                               value="@Model.Ticket.TicketID" />

                        <div class="mb-3">
                            <label asp-for="EscalationTechnicianID"
                                   class="form-label">
                                Receiving Technician
                            </label>

                            <select asp-for="EscalationTechnicianID"
                                    asp-items="Model.EscalationTechnicians"
                                    class="form-select"
                                    required>
                                <option value="0">
                                    -- Select Technician --
                                </option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EscalationReason"
                                   class="form-label">
                                Escalation Reason
                            </label>

                            <textarea asp-for="EscalationReason"
                                      class="form-control"
                                      rows="4"
                                      maxlength="4000"
                                      required
                                      placeholder="Explain why this issue requires additional support..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-warning">
                            Escalate Ticket
                        </button>

                    </form>
                </div>
            </div>
        }

        @if (Model.Ticket.Status == "Escalated" &&
     Model.Ticket.AssignedTechnicianID.HasValue)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Accept Escalated Ticket</h5>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        This ticket has been escalated to Tier
                        @Model.Ticket.CurrentSupportTier
                        and assigned to @Model.Ticket.AssignedTechnician.
                    </p>

                    <form method="post" asp-page-handler="Accept">

                        <input type="hidden"
                               name="id"
                               value="@Model.Ticket.TicketID" />

                        <button type="submit" class="btn btn-primary">
                            Accept Ticket
                        </button>

                    </form>
                </div>
            </div>
        }

        @if (Model.Ticket.Status == "In Progress" &&
     Model.Ticket.AssignedTechnicianID.HasValue)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Resolve Ticket</h5>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        Document how the issue was resolved before
                        marking this ticket as Resolved.
                    </p>

                    <form method="post" asp-page-handler="Resolve">

                        <input type="hidden"
                               name="id"
                               value="@Model.Ticket.TicketID" />

                        <div class="mb-3">
                            <label asp-for="ResolutionNotes"
                                   class="form-label">
                                Resolution Notes
                            </label>

                            <textarea asp-for="ResolutionNotes"
                                      class="form-control"
                                      rows="4"
                                      maxlength="4000"
                                      required
                                      placeholder="Describe the solution and how it was verified..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-success">
                            Resolve Ticket
                        </button>

                    </form>
                </div>
            </div>
        }

        @if (Model.Ticket.Status == "Resolved" &&
     Model.Ticket.AssignedTechnicianID.HasValue)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Close Ticket</h5>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        This ticket has been resolved by
                        @Model.Ticket.AssignedTechnician
                        and is ready for closure.
                    </p>

                    <form method="post" asp-page-handler="Close">

                        <input type="hidden"
                               name="id"
                               value="@Model.Ticket.TicketID" />

                        <button type="submit" class="btn btn-primary">
                            Close Ticket
                        </button>

                    </form>
                </div>
            </div>
        }

        @if (Model.Ticket.ResolvedAt.HasValue)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Resolution Information</h5>
                </div>

                <div class="card-body">

                    <p>
                        <strong>Resolved:</strong>
                        @Model.Ticket.ResolvedAt.Value.ToString("MM/dd/yyyy h:mm tt")
                    </p>

                    @if (Model.Ticket.ClosedAt.HasValue)
                    {
                        <p>
                            <strong>Closed:</strong>
                            @Model.Ticket.ClosedAt.Value.ToString("MM/dd/yyyy h:mm tt")
                        </p>
                    }

                    <strong>Resolution Notes:</strong>
                    <p class="mt-2">@Model.Ticket.ResolutionNotes</p>

                </div>
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    Activity History (@Model.History.Count)
                </h5>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Activity</th>
                                <th>Technician</th>
                                <th>Description</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var activity in Model.History)
                            {
                                <tr>
                                    <td>
                                        @activity.ActivityTimestamp.ToString("MM/dd/yyyy h:mm tt")
                                    </td>
                                    <td>@activity.ActivityType</td>
                                    <td>@activity.Technician</td>
                                    <td>@activity.ActivityDescription</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

                @if (Model.History.Count == 0)
                {
                    <p class="text-muted">
                        No activity history recorded.
                    </p>
                }
            </div>
        </div>
    }
</div>