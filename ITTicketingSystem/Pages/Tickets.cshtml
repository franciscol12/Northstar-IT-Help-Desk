@page
@model ITTicketingSystem.Pages.TicketsModel

@{
    ViewData["Title"] = "Support Tickets";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Support Tickets</h1>
        <p class="text-muted">
            View and manage IT support requests.
        </p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get" asp-page="/Tickets">

                <div class="row align-items-end g-3">

                    <div class="col-md-4">
                        <label for="statusFilter" class="form-label">
                            Filter by Status
                        </label>

                        <select id="statusFilter"
                                name="status"
                                class="form-select">

                            @foreach (var status in new[]
                            {
                            "All",
                            "Open",
                            "In Progress",
                            "Escalated",
                            "Resolved",
                            "Closed"
                        })
                            {
                                if (Model.SelectedStatus == status)
                                {
                                    <option value="@status" selected>
                                        @status
                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @status
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="priorityFilter" class="form-label">
                            Filter by Priority
                        </label>

                        <select id="priorityFilter"
                                name="priority"
                                class="form-select">

                            @foreach (var priority in new[]
                            {
                                    "All",
                                    "Low",
                                    "Medium",
                                    "High",
                                    "Critical"
                                })
                            {
                                if (Model.SelectedPriority == priority)
                                {
                                    <option value="@priority" selected>
                                        @priority
                                    </option>
                                }
                                else
                                {
                                    <option value="@priority">
                                        @priority
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-primary">
                            Apply Filter
                        </button>
                    </div>

                    <div class="col-md-auto">
                        <a asp-page="/Tickets"
                           class="btn btn-outline-secondary">
                            Clear Filter
                        </a>
                    </div>

                </div>

            </form>

        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    All Support Tickets (@Model.Tickets.Count)
                </h5>
            </div>

            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Ticket ID</th>
                                <th>Title</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Assigned Technician</th>
                                <th>Created</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var ticket in Model.Tickets)
                            {
                                <tr>
                                    <td>
                                        <a asp-page="/TicketDetails"
                                           asp-route-id="@ticket.TicketID"
                                           class="fw-semibold text-decoration-none">
                                            #@ticket.TicketID
                                        </a>
                                    </td>
                                    <td>@ticket.Title</td>
                                    <td>
                                        @{
                                            string priorityColor = ticket.Priority switch
                                            {
                                                "Critical" => "bg-danger",
                                                "High" => "bg-warning text-dark",
                                                "Medium" => "bg-info text-dark",
                                                "Low" => "bg-secondary",
                                                _ => "bg-secondary"
                                            };
                                        }

                                        <span class="badge @priorityColor">
                                            @ticket.Priority
                                        </span>
                                    </td>

                                    <td>
                                        @{
                                            string statusColor = ticket.Status switch
                                            {
                                                "Open" => "bg-secondary",
                                                "In Progress" => "bg-primary",
                                                "Escalated" => "bg-warning text-dark",
                                                "Resolved" => "bg-success",
                                                "Closed" => "bg-dark",
                                                _ => "bg-secondary"
                                            };
                                        }

                                        <span class="badge @statusColor">
                                            @ticket.Status
                                        </span>
                                    </td>
                                    <td>@ticket.AssignedTechnician</td>
                                    <td>
                                        @ticket.CreatedAt.ToString("MM/dd/yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

                @if (Model.Tickets.Count == 0)
                {
                    <p class="text-muted text-center mt-3">
                        No support tickets found.
                    </p>
                }

            </div>
        </div>
    }

</div>