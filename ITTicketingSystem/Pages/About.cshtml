@page

@{
    ViewData["Title"] = "About Northstar";
}

<div class="mb-4">
    <h1>About Northstar</h1>
    <p class="text-muted">
        Learn about the IT support ticketing system,
        its capabilities, and its technologies.
    </p>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <h4>What is Northstar IT Help Desk?</h4>

        <p class="text-muted mb-0">
            Northstar IT Help Desk is an IT support ticketing
            system prototype designed to organize technical
            support requests, coordinate technician assignments,
            and document troubleshooting activity.

            The system provides a structured workflow for
            managing requests from initial submission through
            resolution and closure.
        </p>
    </div>
</div>

<h4 class="mb-3">Core Features</h4>

<div class="row g-3 mb-4">

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <h5>Ticket Management</h5>
                <p class="text-muted mb-0">
                    Create, assign, track, resolve, and close
                    IT support tickets.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <h5>Technician Escalation</h5>
                <p class="text-muted mb-0">
                    Escalate unresolved technical issues
                    between support tiers.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <h5>Activity History</h5>
                <p class="text-muted mb-0">
                    Maintain a record of ticket assignments,
                    troubleshooting, escalation, and resolution.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <h5>Reporting and Analytics</h5>
                <p class="text-muted mb-0">
                    Monitor support ticket statuses,
                    priorities, technician workloads,
                    and ticket aging.
                </p>
            </div>
        </div>
    </div>

</div>

<h4 class="mb-3">Technology Stack</h4>

<div class="card mb-4">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <strong>Frontend</strong>
                <p class="text-muted">
                    HTML, CSS, Bootstrap, Razor Pages
                </p>
            </div>

            <div class="col-md-6">
                <strong>Backend</strong>
                <p class="text-muted">
                    C#, ASP.NET Core
                </p>
            </div>

            <div class="col-md-6">
                <strong>Database</strong>
                <p class="text-muted">
                    Microsoft SQL Server
                </p>
            </div>

            <div class="col-md-6">
                <strong>Development Tools</strong>
                <p class="text-muted">
                    Visual Studio, SQL Server Management Studio
                </p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <h4>Project Purpose</h4>

        <p class="text-muted mb-0">
            Northstar was developed as an independent
            Management Information Systems project to
            demonstrate relational database design,
            SQL stored procedures, business process
            modeling, reporting, application development,
            and systematic testing.
        </p>
    </div>
</div>
